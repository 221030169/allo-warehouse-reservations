datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

model Product {
  id          String        @id @default(uuid())
  name        String
  sku         String        @unique
  description String?
  price       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  stocks      Stock[]
  reservations Reservation[]
}

model Warehouse {
  id           String        @id @default(uuid())
  name         String
  location     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stocks       Stock[]
  reservations Reservation[]
}

model Stock {
  productId   String
  warehouseId String
  quantity    Int       // Total units physically present
  reserved    Int       // Total units currently reserved (pending)
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
}

model Reservation {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int
  status      String    // "PENDING", "CONFIRMED", "RELEASED"
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model Idempotency {
  key            String   @id
  responseStatus Int
  responseBody   String   // JSON string of response
  createdAt      DateTime @default(now())
}
